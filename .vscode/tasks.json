{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Axiom: project checks",
      "type": "process",
      "command": "python3",
      "args": [
        "scripts/check_project.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Axiom: portable tests",
      "type": "process",
      "command": "python3",
      "args": [
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests",
        "-v"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Axiom: native verify",
      "type": "process",
      "command": "python3",
      "args": [
        "lab.py",
        "verify"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Axiom: benchmark",
      "type": "process",
      "command": "python3",
      "args": [
        "lab.py",
        "bench",
        "--samples",
        "15"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
